# Comma-separated list of every address the PC might be reachable at, most
# preferred first. Include the Tailscale MagicDNS name (survives IP changes),
# the Tailscale IP, the LAN IP and the hotspot IP. The app probes them all in
# parallel and uses the first one that answers. Users can edit the list in-app.
#
#   tailscale status --json | jq -r .Self.DNSName   -> MagicDNS name
#   tailscale ip -4                                  -> Tailscale IP
#   hostname -I | awk '{print $1}'                   -> LAN IP
#   10.42.0.1 is the PC when it runs a NetworkManager hotspot
EXPO_PUBLIC_SERVERS=http://your-pc.your-tailnet.ts.net:2000,http://100.x.y.z:2000,http://192.168.1.x:2000,http://10.42.0.1:2000

# Legacy single address, still honoured if EXPO_PUBLIC_SERVERS is unset.
# EXPO_PUBLIC_SERVER=http://100.x.y.z:2000

# ---------------------------------------------------------------------------
# This file is only read for LOCAL runs (expo start, eas build --local).
# mobile/.env is gitignored, and EAS Build uploads only git-tracked files, so a
# CLOUD build sees none of it and DEFAULT_SERVERS collapses to localhost:2000.
# Cloud builds read EAS-hosted environment variables instead; each build profile
# in eas.json names the environment it loads via "environment".
#
# Upload the list once per environment (values stay in EAS, never in git):
#   eas login
#   eas env:create --name EXPO_PUBLIC_SERVERS --value "<same value as above>" \
#     --visibility sensitive --environment development --environment preview \
#     --environment production
#
# Verify before building:  eas env:list --environment production
# ---------------------------------------------------------------------------
