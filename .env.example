# Linux username for PAM authentication and session detection
# Run: whoami
LINUX_USER=your_username

# UID of the Linux user
# Run: id -u
LINUX_UID=1000

# Port for the FastAPI server
SERVER_PORT=8000

# Tailscale IP of this PC
# Run: tailscale ip -4
TAILSCALE_IP=your_tailscale_ip

# Home LAN IP of this PC
# Run: hostname -I | awk '{print $1}'
HOME_LAN_IP=your_lan_ip

# Phone IP on hotspot (for phone-away-lock feature)
# Check phone hotspot settings or run: arp -a
PHONE_HOTSPOT_IP=your_phone_ip
