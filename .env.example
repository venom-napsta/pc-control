# Linux username for PAM authentication and session detection
# Run: whoami
LINUX_USER=your_username

# UID of the Linux user
# Run: id -u
LINUX_UID=1000

# Port for the FastAPI server
SERVER_PORT=2000

# Interface to listen on. 0.0.0.0 = every network (LAN, hotspot, Tailscale).
# The x-pin header travels in cleartext on plain Wi-Fi, so firewall port
# SERVER_PORT to tailscale0 (see README "Network exposure") or bind the
# Tailscale IP only:  BIND_HOST=100.x.y.z
BIND_HOST=0.0.0.0

# Tailscale IP of this PC
# Run: tailscale ip -4
TAILSCALE_IP=your_tailscale_ip

# Home LAN IP of this PC
# Run: hostname -I | awk '{print $1}'
HOME_LAN_IP=your_lan_ip

# Phone IP on hotspot (for phone-away-lock feature)
# Check phone hotspot settings or run: arp -a
PHONE_HOTSPOT_IP=your_phone_ip

# Seconds a successfully verified PIN is remembered before PAM is consulted
# again. PAM costs hundreds of ms per call; the app polls every few seconds.
# Set 0 to verify every request.
PIN_CACHE_TTL=300

# PAM service for PIN checks. Default "login" works untouched but has a 3 s
# failure delay and makes the intruder watcher fire on mistyped phone PINs.
# After `sudo install -m 644 pam/pc-control /etc/pam.d/pc-control`, set:
# PAM_SERVICE=pc-control

# Brute-force lockout: after AUTH_MAX_FAILURES wrong PINs from one address it
# is refused for AUTH_LOCKOUT_S seconds, doubling on each further strike.
AUTH_MAX_FAILURES=5
AUTH_LOCKOUT_S=60

# How long a session token stays valid while idle, refreshed on each use.
# POST /login trades the password for one so ordinary polls stop carrying it.
# Set 0 to disable /login entirely and force the PIN on every request.
SESSION_TTL=28800

# Largest file the phone may push to the PC. Streamed in chunks, so a big one
# never sits in memory.
UPLOAD_MAX_BYTES=536870912

# Largest image accepted onto the PC clipboard. Much smaller than an upload:
# GPaste keeps the whole image in its history, and the realistic payload is a
# phone screenshot rather than a disk image.
CLIPBOARD_IMAGE_MAX_BYTES=33554432
